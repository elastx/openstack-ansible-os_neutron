# Ansible managed
export LC_ALL=en_US.UTF-8

# COMMON OPENSTACK ENVS
export OS_ENDPOINT_TYPE=internalURL
export OS_INTERFACE=internalURL
export OS_USERNAME={{ elx_netbilling_credentials.username }}
export OS_PASSWORD={{ elx_netbilling_credentials.password }}
export OS_PROJECT_NAME={{ elx_netbilling_credentials.username }}
export OS_TENANT_NAME={{ elx_netbilling_credentials.username }}
export OS_AUTH_TYPE=password
export OS_AUTH_URL=http://{{ internal_lb_vip_address }}:5000/v3
export OS_USER_DOMAIN_NAME=Default
export OS_PROJECT_DOMAIN_NAME=Default
export OS_REGION_NAME=se-sto

# For openstackclient
export OS_IDENTITY_API_VERSION=3
export OS_AUTH_VERSION=3
